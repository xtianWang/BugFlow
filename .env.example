# Documentation only: app does not auto-load .env. Export these in your process environment.
BUGFLOW_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
BUGFLOW_DATABASE_URL=sqlite:///bugflow.db
BUGFLOW_LLM_BASE_URL=https://api.openai.com/v1
BUGFLOW_LLM_MODEL=replace-with-your-tool-calling-model
BUGFLOW_LLM_API_KEY=
BUGFLOW_LLM_THINKING=
BUGFLOW_AGENT_REPOSITORIES={}
# Linux worker only; requires installed runsc and a prebuilt dependency image.
BUGFLOW_SANDBOX_IMAGE=
